<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171a21" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta
      name="description"
      content={gettext("Afinados gathers calculation tools for motorcycle tuning.")}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Afinados" />
    <meta
      property="og:title"
      content={gettext("Afinados, calculation tools for motorcycle tuning")}
    />
    <meta
      property="og:description"
      content={gettext("Afinados gathers calculation tools for motorcycle tuning.")}
    />
    <meta property="og:url" content={url(~p"/")} />
    <meta property="og:image" content="https://afinados.io/og-image.svg" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Afinados" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={gettext("Afinados, calculation tools for motorcycle tuning")}
    />
    <meta
      name="twitter:description"
      content={gettext("Afinados gathers calculation tools for motorcycle tuning.")}
    />
    <meta name="twitter:image" content="https://afinados.io/og-image.svg" />
    <meta name="twitter:image:alt" content="Afinados" />
    <.live_title default="Afinados">{assigns[:page_title]}</.live_title>
    <script nonce={@csp_nonce}>
      var savedTheme = window.localStorage && localStorage.getItem("theme");
      var prefersLight =
        window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches;
      var hasSavedTheme = savedTheme === "dark" || savedTheme === "light";
      var fallbackTheme = prefersLight ? "light" : "dark";
      var effectiveTheme = hasSavedTheme ? savedTheme : fallbackTheme;
      document.documentElement.setAttribute("data-theme", effectiveTheme);
      var themeColorMeta = document.querySelector('meta[name="theme-color"]');
      if (themeColorMeta)
        themeColorMeta.setAttribute("content", effectiveTheme === "dark" ? "#171a21" : "#f9fafb");
    </script>
    <link phx-track-static rel="stylesheet" href={asset_url(~p"/assets/css/app.css")} />
    <script defer phx-track-static type="text/javascript" src={asset_url(~p"/assets/js/app.js")}>
    </script>
  </head>
  <body>
    <header class="topbar">
      <a href={~p"/"} class="brand">Afinados <small class="version">v{app_version()}</small></a>
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label={gettext("Toggle theme")}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" />
        </svg>
      </button>
    </header>
    {@inner_content}
  </body>
</html>
