<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Afinados">{assigns[:page_title]}</.live_title>
    <script nonce={@csp_nonce}>
      var savedTheme = window.localStorage && localStorage.getItem("theme");
      if (savedTheme === "dark" || savedTheme === "light")
        document.documentElement.setAttribute("data-theme", savedTheme);
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <header class="topbar">
      <span class="brand">Afinados <small class="version">v{app_version()}</small></span>
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label={gettext("Toggle theme")}
      >
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
          <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" />
        </svg>
      </button>
    </header>
    {@inner_content}
  </body>
</html>
